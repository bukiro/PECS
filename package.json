{
    "name": "@bukiro/pecs",
    "version": "1.0.16",
    "author": {
        "name": "Arne Brandt"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bukiro/PECS.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/bukiro"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve --host 0.0.0.0 --disable-host-check --live-reload=false",
        "watch": "ng serve --host 0.0.0.0 --disable-host-check",
        "build": "ng build --configuration=production --output-path=./build",
        "build-demo": "ng build --configuration=production --output-path=../build/docs --base-href=/PECS-Demo/",
        "publish": "ng build --configuration=production --output-path=./publish/src",
        "publish-win": "cd publish && nexe ./pecs.js -t win-x64-16.16.0 --build && cd ..",
        "publish-linux": "cd publish && nexe ./pecs.js -t linux-x64-16.16.0 --build && cd ..",
        "test": "jest",
        "lint": "ng lint",
        "lint-fix": "ng lint --fix",
        "e2e": "ng e2e"
    },
    "dependencies": {
        "@angular/animations": "^20.2.3",
        "@angular/cdk": "^20.2.1",
        "@angular/common": "^20.2.3",
        "@angular/compiler": "^20.2.3",
        "@angular/core": "^20.2.3",
        "@angular/forms": "^20.2.3",
        "@angular/localize": "^20.2.3",
        "@angular/platform-browser": "^20.2.3",
        "@angular/platform-browser-dynamic": "^20.2.3",
        "@angular/router": "^20.2.3",
        "@ng-bootstrap/ng-bootstrap": "^19.0.1",
        "@ngrx/signals": "^20.0.1",
        "@ngrx/store": "^20.0.1",
        "@popperjs/core": "^2.11.8",
        "body-parser": "^2.2.0",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "gzip-js": "^0.3.2",
        "md5": "^2.3.0",
        "mongodb": "^6.19.0",
        "node-json-db": "^2.3.1",
        "rpg-awesome": "^0.2.0",
        "rxjs": "^7.8.2",
        "ts-md5": "^2.0.1",
        "uuid": "^11.1.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^20.2.1",
        "@angular-eslint/builder": "20.2.0",
        "@angular-eslint/eslint-plugin": "20.2.0",
        "@angular-eslint/eslint-plugin-template": "20.2.0",
        "@angular-eslint/schematics": "20.2.0",
        "@angular-eslint/template-parser": "20.2.0",
        "@angular/cli": "^20.2.1",
        "@angular/compiler-cli": "^20.2.3",
        "@angular/language-service": "^20.2.3",
        "@ngneat/spectator": "^21.0.1",
        "@team23/eslint-config-team23-angular": "^20.1.0",
        "@team23/eslint-config-team23-standard": "^10.1.5",
        "@team23/eslint-config-team23-ts": "^10.2.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.41.0",
        "@typescript-eslint/parser": "^8.41.0",
        "angular-cli-ghpages": "^2.0.3",
        "eslint": "^9.34.0",
        "eslint-plugin-jest": "^29.0.1",
        "fuzzy": "^0.1.3",
        "jest": "^29.7.0",
        "jest-preset-angular": "^14.6.1",
        "prettier": "^3.6.2",
        "stylelint": "^16.23.1",
        "ts-node": "^10.9.2",
        "typescript": "5.9"
    }
}
